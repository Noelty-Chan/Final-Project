{
  "hosting": {
    "public": ".",
    "redirects": [
      {
        "source": "/",
        "destination": "/create/",
        "type": 302
      }
    ],
    "ignore": [
      "firebase.json",
      "firebaserc",
      ".firebaserc",
      ".git",
      ".git/**",
      "**/.git",
      "**/.git/**",
      "**/.*",
      "**/node_modules/**",
      "logs/**",
      "firepit-log.txt"
    ]
  },
  "emulators": {
    "dataconnect": {
      "dataDir": "dataconnect/.dataconnect/pgliteData"
    }
  },
  "dataconnect": {
    "source": "dataconnect"
  }
}
